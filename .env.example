# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Flat names in this file are the canonical external settings contract.
# Legacy SECTION__FIELD aliases remain supported only as a fallback; when both
# names are present in the same source, the flat name wins.

# Application environment: development | staging | production
APP_ENV=development

# Application name
APP_NAME=quant_trading_bot

# Application host and port
APP_HOST=0.0.0.0
APP_PORT=8000

# Debug mode
DEBUG=true

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
# Docker Compose reads this secret directly. Set a non-placeholder value in .env.
POSTGRES_PASSWORD=change-me
# Keep this password in sync with POSTGRES_PASSWORD for local host connections.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/quant_trading

# Synchronous database URL (for Alembic migrations)
DATABASE_URL_SYNC=postgresql://postgres:change-me@localhost:5432/quant_trading

# Database pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection URL
REDIS_URL=redis://:change-me@localhost:6379/0

# Redis password (if required)
REDIS_PASSWORD=change-me

# Redis connection settings
REDIS_DECODE_RESPONSES=true
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# EXCHANGE CONFIGURATION
# =============================================================================

# Exchange mode: fake | paper | live
EXCHANGE_MODE=fake

# Default exchange to use
DEFAULT_EXCHANGE=binance

# Paper trading mode (safety flag)
PAPER_TRADING=true

# Exchange API endpoints (for different exchanges)
BINANCE_API_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

OKX_API_URL=https://www.okx.com
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public

# Rate limiting
EXCHANGE_MAX_REQUESTS_PER_SECOND=10
EXCHANGE_BURST_LIMIT=20

# =============================================================================
# WORKER CONFIGURATION
# =============================================================================

# Worker heartbeat interval (seconds)
WORKER_HEARTBEAT_INTERVAL=30

# Worker shutdown timeout (seconds)
WORKER_SHUTDOWN_TIMEOUT=60

# Market data worker
MARKET_DATA_WORKER_ENABLED=true
MARKET_DATA_CACHE_TTL=60

# Strategy worker
STRATEGY_WORKER_ENABLED=true
STRATEGY_WORKER_INTERVAL=60

# Execution worker
EXECUTION_WORKER_ENABLED=true

# Reconciliation worker
RECONCILIATION_WORKER_ENABLED=true
RECONCILIATION_WORKER_INTERVAL=300

# Monitoring worker
MONITORING_WORKER_ENABLED=true

# =============================================================================
# TRADING PARAMETERS (defaults - should be overridden by risk module)
# =============================================================================

# Default position size (% of capital)
DEFAULT_POSITION_SIZE=1.0

# Maximum position size (% of capital)
MAX_POSITION_SIZE=10.0

# Maximum drawdown (% of capital)
MAX_DRAWDOWN=20.0

# Maximum daily loss (% of capital)
MAX_DAILY_LOSS=5.0

# =============================================================================
# TELEGRAM ALERTING
# =============================================================================

# Telegram bot token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID for alerts
TELEGRAM_CHAT_ID=

# Enable/disable alerts
ALERTS_ENABLED=false

# Alert severity thresholds
ALERT_INFO_THRESHOLD=INFO
ALERT_WARNING_THRESHOLD=WARNING
ALERT_ERROR_THRESHOLD=ERROR

# =============================================================================
# METRICS & OBSERVABILITY
# =============================================================================

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Health check
HEALTH_CHECK_ENABLED=true

# Structured logging
STRUCTLOG_ENABLED=true
STRUCTLOG_FORMAT=json

# =============================================================================
# BACKTESTING CONFIGURATION
# =============================================================================

# Default backtest settings
BACKTEST_INITIAL_CAPITAL=10000.0
BACKTEST_COMMISSION=0.001
BACKTEST_SLIPPAGE=0.0005

# Data paths
BACKTEST_DATA_PATH=./datasets/processed
